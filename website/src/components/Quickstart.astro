---
import { quickstart } from '../data/site';
---

<style>
  .quickstart {
    padding: clamp(3.5rem, 7vw, 6rem) 1.5rem;
    max-width: 78rem;
    margin: 0 auto;
  }

  .quickstart__head {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .quickstart__head h2 {
    font-family: var(--yard-font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 0.95;
    color: var(--yard-ink);
    margin: 0 0 0.75rem;
  }

  .quickstart__head p {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--yard-ink-muted);
    max-width: 60ch;
  }

  .manifest {
    border: 2px solid var(--yard-asphalt);
    background: var(--yard-paper);
  }

  .manifest__rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 1rem;
    background: var(--yard-asphalt);
    color: var(--yard-paper);
    font-family: var(--yard-font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .manifest__rail span:last-child {
    font-family: var(--yard-font-mono);
    font-weight: 400;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--yard-hazard);
  }

  .manifest__rows {
    display: flex;
    flex-direction: column;
  }

  .manifest__row {
    margin: 0;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0;
    border-bottom: var(--yard-rule-w) solid var(--yard-rule);
  }

  .manifest__row:last-child {
    border-bottom: none;
  }

  .manifest__seq {
    display: grid;
    place-items: center;
    border-right: 2px solid var(--yard-asphalt);
    background: var(--yard-concrete-deep);
    font-family: var(--yard-font-mono);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    color: var(--yard-ink-muted);
  }

  .manifest__cell {
    min-width: 0;
    padding: 0.75rem 0.9rem;
  }

  .manifest__label {
    display: block;
    font-family: var(--yard-font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1.125rem;
    line-height: 1;
    color: var(--yard-ink);
    margin-bottom: 0.45rem;
  }

  .code-block {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    min-width: 0;
  }

  .code-block pre {
    flex: 1;
    min-width: 0;
    margin: 0;
    overflow-x: auto;
    max-width: 100%;
    font-family: var(--yard-font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--yard-ink);
    background: var(--yard-concrete);
    border: var(--yard-rule-w) solid var(--yard-rule);
    padding: 0.55rem 0.7rem;
  }

  .code-block code {
    font-family: inherit;
    white-space: pre;
  }

  .copy-btn {
    display: none;
    flex-shrink: 0;
    padding: 0.55rem 0.8rem;
    border: 2px solid var(--yard-asphalt);
    background: transparent;
    color: var(--yard-ink);
    font-family: var(--yard-font-display);
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  html.js .copy-btn {
    display: inline-flex;
    align-items: center;
  }

  .copy-btn:hover {
    background: var(--yard-asphalt);
    color: var(--yard-paper);
  }

  .copy-btn:focus-visible {
    outline: 3px solid var(--yard-safety-deep);
    outline-offset: 2px;
  }

  .copy-btn[data-copied] {
    background: var(--yard-safety);
    border-color: var(--yard-asphalt);
    color: var(--yard-on-safety);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>

<section id="quickstart" class="quickstart" aria-labelledby="quickstart-heading">
  <div class="quickstart__head">
    <h2 id="quickstart-heading">Quickstart</h2>
    <p>
      Seven loading orders take a bare Linux host to a running service. Copy each
      one in order — the whole run is a single bill of lading.
    </p>
  </div>

  <div class="manifest">
    <div class="manifest__rail">
      <span>Load order</span>
      <span>host → yard</span>
    </div>
    <div class="manifest__rows">
      {quickstart.map((cmd, i) => (
        <figure class="manifest__row">
          <span class="manifest__seq" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="manifest__cell">
            <figcaption class="manifest__label">{cmd.label}</figcaption>
            <div class="code-block">
              <pre><code id={`cmd-${i + 1}`}>{cmd.code}</code></pre>
              <button
                type="button"
                class="copy-btn"
                data-copy-target={`#cmd-${i + 1}`}
                aria-label={`Copy: ${cmd.label}`}
              >
                Copy
              </button>
            </div>
            <span class="sr-only" aria-live="polite" role="status"></span>
          </div>
        </figure>
      ))}
    </div>
  </div>
</section>

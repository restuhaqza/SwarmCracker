---
import { stats } from '../data/site';
---

<section aria-labelledby="stats-heading" class="stat-strip">
  <h2 id="stats-heading" class="sr-only">Project statistics</h2>
  <div class="stat-strip__grid">
    {stats.map((stat) => (
      <div class="stat-strip__item">
        <span class="stat__value">{stat.value}</span>
        <span class="stat__label">{stat.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .stat-strip {
    padding: 3rem 1.5rem;
    background: var(--sc-surface);
    border-top: 1px solid var(--sc-border);
    border-bottom: 1px solid var(--sc-border);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .stat-strip__grid {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1.5rem;
  }

  .stat-strip__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.25rem;
  }

  .stat__value {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--sc-orange);
    line-height: 1.2;
  }

  .stat__label {
    font-size: 0.875rem;
    color: var(--sc-text-muted);
    line-height: 1.4;
  }
</style>

---
import { nav, site } from '../data/site';
---

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--yard-concrete);
    border-bottom: var(--yard-rule-w) solid var(--yard-steel-dark);
  }

  .header-inner {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 1rem;
    max-width: 78rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    min-height: 4rem;
  }

  /* Brand reads as a stencilled container marking */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--yard-ink);
    padding: 0.5rem 0;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    background: var(--yard-safety);
    color: var(--yard-on-safety);
    border: 2px solid var(--yard-asphalt);
  }

  .brand__mark svg {
    width: 1.5rem;
    height: 1.5rem;
    display: block;
  }

  .brand__word {
    font-family: var(--yard-font-display);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .brand__id {
    font-family: var(--yard-font-mono);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--yard-ink-muted);
    text-transform: uppercase;
    border-left: var(--yard-rule-w) solid var(--yard-rule);
    padding-left: 0.75rem;
    margin-left: 0.25rem;
  }

  .brand:hover .brand__word {
    color: var(--yard-rust);
  }

  /* Desktop nav — manifest items */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .desktop-nav a:not(.get-started-btn) {
    font-family: var(--yard-font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--yard-ink-muted);
    text-decoration: none;
    padding: 0.75rem 0.9rem;
    border-bottom: 3px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .desktop-nav a:not(.get-started-btn):hover {
    color: var(--yard-ink);
    border-bottom-color: var(--yard-safety);
  }

  .desktop-nav a:not(.get-started-btn):focus-visible {
    outline: 3px solid var(--yard-safety-deep);
    outline-offset: -3px;
  }

  /* CTA — a safety tag: black on orange, hard-edged */
  .get-started-btn {
    display: inline-flex;
    align-items: center;
    margin-left: 0.5rem;
    padding: 0.6rem 1.25rem;
    background: var(--yard-safety);
    color: var(--yard-on-safety);
    font-family: var(--yard-font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border: 2px solid var(--yard-asphalt);
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .get-started-btn:hover {
    background: var(--yard-hazard);
  }

  .get-started-btn:active {
    transform: translateY(1px);
  }

  .get-started-btn:focus-visible {
    outline: 3px solid var(--yard-asphalt);
    outline-offset: 2px;
  }

  /* Mobile nav — <details>/<summary> toggle, no JS */
  .mobile-nav-toggle {
    display: none;
    align-self: center;
  }

  .mobile-nav-toggle summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    color: var(--yard-ink);
    font-family: var(--yard-font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 2px solid var(--yard-steel-dark);
    background: transparent;
  }

  .mobile-nav-toggle summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav-toggle summary::marker {
    display: none;
    content: '';
  }

  .mobile-nav-toggle summary:focus-visible {
    outline: 3px solid var(--yard-safety-deep);
    outline-offset: 2px;
  }

  .mobile-nav-toggle[open] summary {
    background: var(--yard-asphalt);
    color: var(--yard-paper);
    border-color: var(--yard-asphalt);
  }

  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--yard-asphalt);
    border-bottom: 4px solid var(--yard-safety);
    padding: 1rem 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-menu a {
    color: var(--yard-paper);
    text-decoration: none;
    font-family: var(--yard-font-display);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.7rem 0;
    border-bottom: var(--yard-rule-w) solid rgba(232, 230, 224, 0.18);
  }

  .mobile-menu a:hover {
    color: var(--yard-hazard);
  }

  .mobile-menu a:focus-visible {
    outline: 3px solid var(--yard-hazard);
    outline-offset: 2px;
  }

  @media (max-width: 720px) {
    .desktop-nav {
      display: none;
    }
    .mobile-nav-toggle {
      display: block;
    }
    .brand__id {
      display: none;
    }
  }
</style>

<a href="#main" class="skip-link">Skip to content</a>

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="SwarmCracker — home">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter">
          <rect x="2.5" y="6" width="19" height="12" />
          <line x1="7" y1="6" x2="7" y2="18" />
          <line x1="12" y1="6" x2="12" y2="18" />
          <line x1="17" y1="6" x2="17" y2="18" />
        </svg>
      </span>
      <span class="brand__word">SwarmCracker</span>
      <span class="brand__id">{site.version}</span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href="#quickstart" class="get-started-btn">Get Started</a>
    </nav>

    <details class="mobile-nav-toggle">
      <summary aria-label="Toggle navigation menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        Menu
      </summary>
      <nav class="mobile-menu" aria-label="Mobile navigation">
        {nav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
        <a href="#quickstart">Get Started</a>
      </nav>
    </details>
  </div>
</header>

---
import { features, type IconName } from '../data/site';

const icons: Record<IconName, string> = {
  kernel: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"><rect x="3" y="7" width="26" height="18"/><rect x="12" y="12" width="8" height="8"/><line x1="12" y1="7" x2="12" y2="12"/><line x1="20" y1="7" x2="20" y2="12"/><line x1="12" y1="20" x2="12" y2="25"/><line x1="20" y1="20" x2="20" y2="25"/></svg>`,
  swarm: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"><line x1="4" y1="8" x2="28" y2="8"/><line x1="4" y1="8" x2="4" y2="12"/><line x1="28" y1="8" x2="28" y2="12"/><line x1="16" y1="8" x2="16" y2="15"/><path d="M10 20a6 6 0 0 0 12 0"/><line x1="16" y1="15" x2="16" y2="20"/></svg>`,
  kvm: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"><rect x="8" y="8" width="16" height="16"/><line x1="8" y1="13" x2="4" y2="13"/><line x1="8" y1="19" x2="4" y2="19"/><line x1="24" y1="13" x2="28" y2="13"/><line x1="24" y1="19" x2="28" y2="19"/><path d="M14 16l2.5 2.5L20 13"/></svg>`,
  boot: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"><rect x="9" y="8" width="14" height="16"/><line x1="5" y1="11" x2="2" y2="11"/><line x1="5" y1="16" x2="1" y2="16"/><line x1="5" y1="21" x2="2" y2="21"/><path d="M18 12l-4 5h3l-2 5 5-6h-3l1-4z" fill="currentColor" stroke="none"/></svg>`,
  network: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"><rect x="3" y="9" width="10" height="14"/><rect x="19" y="9" width="10" height="14"/><path d="M13 16h6"/><circle cx="16" cy="16" r="2" fill="currentColor" stroke="none"/></svg>`,
  update: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"><rect x="6" y="6" width="20" height="6"/><rect x="6" y="14" width="20" height="6"/><rect x="6" y="22" width="20" height="6"/><path d="M27 20a4 4 0 1 1-2-3.5"/><path d="M25 14l2 2.5-3 .5"/></svg>`,
};

// Deliberately uneven spans: a spec board, not a grid of identical cards.
const spans = [7, 5, 5, 7, 6, 6];
const refs = ['SPEC 01 · KRNL', 'SPEC 02 · SWRM', 'SPEC 03 · KVM', 'SPEC 04 · BOOT', 'SPEC 05 · NET', 'SPEC 06 · ROLL'];
---

<style>
  .specs {
    padding: clamp(3.5rem, 7vw, 6rem) 1.5rem;
    max-width: 78rem;
    margin: 0 auto;
  }

  .specs__head {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .specs__head h2 {
    font-family: var(--yard-font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 0.95;
    color: var(--yard-ink);
    margin: 0 0 0.75rem;
  }

  .specs__head p {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--yard-ink-muted);
    max-width: 60ch;
  }

  .specs__board {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0.75rem;
  }

  .plate {
    grid-column: span 12;
    display: flex;
    flex-direction: column;
    background: var(--yard-paper);
    border: 2px solid var(--yard-asphalt);
  }

  @media (min-width: 52rem) {
    .plate {
      grid-column: span var(--span);
    }
  }

  .plate__rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.45rem 0.7rem;
    background: var(--yard-asphalt);
    color: var(--yard-paper);
  }

  .plate__ref {
    font-family: var(--yard-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--yard-hazard);
  }

  .plate__icon {
    color: var(--yard-paper);
    line-height: 0;
  }

  .plate__icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
    display: block;
  }

  .plate__body {
    padding: 1.1rem 1.15rem 1.25rem;
    flex: 1;
  }

  .plate__title {
    font-family: var(--yard-font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.625rem;
    line-height: 1;
    color: var(--yard-ink);
    margin: 0 0 0.5rem;
  }

  .plate__text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--yard-ink-muted);
    max-width: 52ch;
  }

  .plate--lead .plate__title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }
</style>

<section id="features" class="specs" aria-labelledby="specs-heading">
  <div class="specs__head">
    <h2 id="specs-heading">Why SwarmCracker?</h2>
    <p>
      Six things the executor guarantees for every task it places — drawn from the
      same spec sheet the microVMs are built to.
    </p>
  </div>

  <div class="specs__board">
    {features.map((feature, i) => (
      <article class:list={['plate', i === 0 && 'plate--lead']} style={`--span: ${spans[i]}`}>
        <div class="plate__rail">
          <span class="plate__ref">{refs[i]}</span>
          <span class="plate__icon" aria-hidden="true" set:html={icons[feature.icon]} />
        </div>
        <div class="plate__body">
          <h3 class="plate__title">{feature.title}</h3>
          <p class="plate__text">{feature.body}</p>
        </div>
      </article>
    ))}
  </div>
</section>

---
import { security } from '../data/site';

const [lead, ...rest] = security;
const sealIcon = `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" stroke-linejoin="miter"><path d="M16 3l11 6v8c0 6-5 10-11 12-6-2-11-6-11-12V9z"/><path d="M11 15l3.5 3.5L21 12"/></svg>`;
---

<style>
  .security {
    padding: clamp(3.5rem, 7vw, 6rem) 1.5rem;
    max-width: 78rem;
    margin: 0 auto;
  }

  .security__head {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .security__head h2 {
    font-family: var(--yard-font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 0.95;
    color: var(--yard-ink);
    margin: 0 0 0.75rem;
  }

  .security__head p {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--yard-ink-muted);
    max-width: 60ch;
  }

  .vault {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 58rem) {
    .vault {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: stretch;
    }
  }

  /* Lead seal record — a dark, stencilled plate */
  .seal-lead {
    position: relative;
    background: var(--yard-asphalt);
    color: var(--yard-paper);
    border: 2px solid var(--yard-asphalt);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    overflow: hidden;
  }

  .seal-lead__mark {
    color: var(--yard-hazard);
    line-height: 0;
  }

  .seal-lead__mark :global(svg) {
    width: 3.5rem;
    height: 3.5rem;
    display: block;
  }

  .seal-lead__ref {
    font-family: var(--yard-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--yard-safety);
    text-transform: uppercase;
    position: absolute;
    top: 1rem;
    right: 1rem;
  }

  .seal-lead h3 {
    font-family: var(--yard-font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0;
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    line-height: 0.98;
    margin: 0 0 0.6rem;
    color: var(--yard-paper);
  }

  .seal-lead p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #c4c7c2;
    max-width: 44ch;
  }

  .seal-records {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 2px solid var(--yard-asphalt);
    background: var(--yard-paper);
  }

  .seal-record {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.9rem;
    padding: 1.1rem 1.15rem;
    border-bottom: var(--yard-rule-w) solid var(--yard-rule);
  }

  .seal-record:last-child {
    border-bottom: none;
  }

  .seal-record__icon {
    color: var(--yard-rust);
    line-height: 0;
  }

  .seal-record__icon :global(svg) {
    width: 2rem;
    height: 2rem;
    display: block;
  }

  .seal-record h3 {
    font-family: var(--yard-font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.375rem;
    line-height: 1.05;
    color: var(--yard-ink);
    margin: 0 0 0.3rem;
  }

  .seal-record p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--yard-ink-muted);
  }
</style>

<section id="security" class="security" aria-labelledby="security-heading">
  <div class="security__head">
    <h2 id="security-heading">Security</h2>
    <p>
      The boundary is the point. Every workload is sealed behind a KVM hardware
      edge, not a namespace in a shared kernel.
    </p>
  </div>

  <div class="vault">
    <article class="seal-lead">
      <span class="seal-lead__ref">SEAL · KVM</span>
      <span class="seal-lead__mark" aria-hidden="true" set:html={sealIcon} />
      <div>
        <h3>{lead.title}</h3>
        <p>{lead.body}</p>
      </div>
    </article>

    <ul class="seal-records" role="list">
      {rest.map((point) => (
        <li class="seal-record">
          <span class="seal-record__icon" aria-hidden="true" set:html={sealIcon} />
          <div>
            <h3>{point.title}</h3>
            <p>{point.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

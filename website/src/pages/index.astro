---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Quickstart from '../components/Quickstart.astro';
import Comparison from '../components/Comparison.astro';
import Security from '../components/Security.astro';
import DocsGateway from '../components/DocsGateway.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<BaseLayout title={site.title} description={site.description} canonical={site.canonical}>
  <Nav slot="before-main" />
  <Hero />
  <HowItWorks />
  <FeatureGrid />
  <Quickstart />
  <Comparison />
  <Security />
  <DocsGateway />
  <Footer slot="after-main" />
</BaseLayout>

{
  "schemaVersion": 1,
  "name": "errors",
  "cases": [
    {
      "name": "unknown service is not_found",
      "request": {
        "method": "GET",
        "path": "/v1/services/conformance-suite-absent",
        "role": "reader"
      },
      "expect": {
        "status": 404,
        "errorCode": "not_found"
      }
    },
    {
      "name": "a reader may not write",
      "request": {
        "method": "POST",
        "path": "/v1/services",
        "role": "reader",
        "body": {
          "name": "conformance-forbidden",
          "spec": {"mode": "replicated", "task": {"image": "nginx:alpine"}}
        }
      },
      "expect": {
        "status": 403,
        "errorCode": "forbidden"
      }
    },
    {
      "name": "a patch without If-Match is 428",
      "request": {
        "method": "PATCH",
        "path": "/v1/services/conformance-suite-absent",
        "role": "admin",
        "contentType": "application/merge-patch+json",
        "body": {"labels": {"suite": "conformance"}}
      },
      "expect": {
        "status": 428,
        "errorCode": "conflict"
      }
    },
    {
      "name": "a stale If-Match is 412",
      "mockOnly": true,
      "request": {
        "method": "PATCH",
        "path": "/v1/services/web",
        "role": "admin",
        "contentType": "application/merge-patch+json",
        "headers": {"If-Match": "\"99\""},
        "body": {"labels": {"suite": "conformance"}}
      },
      "expect": {
        "status": 412,
        "errorCode": "conflict"
      }
    },
    {
      "name": "the wrong content type is 415",
      "request": {
        "method": "POST",
        "path": "/v1/services",
        "role": "admin",
        "contentType": "application/json",
        "body": {
          "name": "conformance-content-type",
          "spec": {"mode": "replicated", "task": {"image": "nginx:alpine"}}
        }
      },
      "expect": {
        "status": 415,
        "errorCode": "invalid"
      }
    },
    {
      "name": "an unsupported Accept is 406",
      "request": {
        "method": "GET",
        "path": "/v1/version",
        "role": "reader",
        "accept": "application/vnd.swarmcracker.v2+json"
      },
      "expect": {
        "status": 406,
        "errorCode": "unsupported_version"
      }
    },
    {
      "name": "a disabled snapshot list is 501",
      "absentCapabilities": ["snapshots"],
      "request": {
        "method": "GET",
        "path": "/v1/tasks/conformance-suite-absent/snapshots",
        "role": "admin"
      },
      "expect": {
        "status": 501,
        "errorCode": "not_implemented",
        "jsonPaths": {"error.details.capability": "snapshots"}
      }
    },
    {
      "name": "a disabled snapshot create is 501",
      "absentCapabilities": ["snapshots"],
      "request": {
        "method": "POST",
        "path": "/v1/tasks/conformance-suite-absent/snapshots",
        "role": "admin"
      },
      "expect": {
        "status": 501,
        "errorCode": "not_implemented",
        "jsonPaths": {"error.details.capability": "snapshots"}
      }
    },
    {
      "name": "a disabled task snapshot restore is 501",
      "absentCapabilities": ["snapshots"],
      "request": {
        "method": "POST",
        "path": "/v1/tasks/conformance-suite-absent/snapshots/snap-conformance/restore",
        "role": "admin"
      },
      "expect": {
        "status": 501,
        "errorCode": "not_implemented",
        "jsonPaths": {"error.details.capability": "snapshots"}
      }
    },
    {
      "name": "a disabled task snapshot delete is 501",
      "absentCapabilities": ["snapshots"],
      "request": {
        "method": "DELETE",
        "path": "/v1/tasks/conformance-suite-absent/snapshots/snap-conformance",
        "role": "admin"
      },
      "expect": {
        "status": 501,
        "errorCode": "not_implemented",
        "jsonPaths": {"error.details.capability": "snapshots"}
      }
    },
    {
      "name": "a disabled flat snapshot list is 501",
      "absentCapabilities": ["snapshots"],
      "request": {
        "method": "GET",
        "path": "/v1/snapshots",
        "query": {"task": "conformance-suite-absent"},
        "role": "admin"
      },
      "expect": {
        "status": 501,
        "errorCode": "not_implemented",
        "jsonPaths": {"error.details.capability": "snapshots"}
      }
    },
    {
      "name": "a disabled flat snapshot restore is 501",
      "absentCapabilities": ["snapshots"],
      "request": {
        "method": "POST",
        "path": "/v1/snapshots/snap-conformance/restore",
        "query": {"task": "conformance-suite-absent"},
        "role": "admin"
      },
      "expect": {
        "status": 501,
        "errorCode": "not_implemented",
        "jsonPaths": {"error.details.capability": "snapshots"}
      }
    },
    {
      "name": "a disabled flat snapshot delete is 501",
      "absentCapabilities": ["snapshots"],
      "request": {
        "method": "DELETE",
        "path": "/v1/snapshots/snap-conformance",
        "query": {"task": "conformance-suite-absent"},
        "role": "admin"
      },
      "expect": {
        "status": 501,
        "errorCode": "not_implemented",
        "jsonPaths": {"error.details.capability": "snapshots"}
      }
    },
    {
      "name": "stopping a restored VM that was never restored is no_restored_vm",
      "mutating": true,
      "requiresCapabilities": ["snapshots"],
      "request": {
        "method": "DELETE",
        "path": "/v1/tasks/$task/restored",
        "role": "admin"
      },
      "expect": {
        "status": 404,
        "errorCode": "not_found",
        "jsonPaths": {"error.details.reason": "no_restored_vm"}
      }
    }
  ]
}

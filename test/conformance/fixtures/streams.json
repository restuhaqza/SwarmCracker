{
  "schemaVersion": 1,
  "name": "streams",
  "cases": [
    {
      "name": "events arrive as SSE frames",
      "request": {
        "method": "GET",
        "path": "/v1/events",
        "role": "reader",
        "accept": "text/event-stream"
      },
      "expect": {
        "status": 200,
        "headers": {"Content-Type": "text/event-stream"}
      },
      "stream": {"frames": 2}
    },
    {
      "name": "exec streams frames and ends with exit",
      "request": {
        "method": "POST",
        "path": "/v1/tasks/$task/exec",
        "role": "runner",
        "body": {"command": ["echo", "hello"]}
      },
      "expect": {
        "status": 200,
        "headers": {"Content-Type": "application/x-ndjson"}
      },
      "stream": {"frames": 2, "lastType": "exit"}
    },
    {
      "name": "logs stream frames and end with eof",
      "request": {
        "method": "GET",
        "path": "/v1/tasks/$task/logs",
        "query": {"tail": "10"},
        "role": "reader"
      },
      "expect": {
        "status": 200,
        "headers": {"Content-Type": "application/x-ndjson"}
      },
      "stream": {"frames": 2, "lastType": "eof"}
    },
    {
      "name": "attach relays the console as raw bytes",
      "requiresCapabilities": ["attach"],
      "request": {
        "method": "POST",
        "path": "/v1/tasks/$task/attach",
        "role": "runner"
      },
      "expect": {
        "status": 200,
        "headers": {"Content-Type": "application/octet-stream"}
      },
      "stream": {"bytes": 14}
    }
  ]
}

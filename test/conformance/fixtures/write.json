{
  "schemaVersion": 1,
  "name": "write",
  "cases": [
    {
      "name": "create a service",
      "mutating": true,
      "request": {
        "method": "POST",
        "path": "/v1/services",
        "role": "admin",
        "body": {
          "name": "conformance-ws-{{run}}",
          "labels": {"suite": "conformance"},
          "spec": {
            "mode": "replicated",
            "replicas": 1,
            "task": {"image": "nginx:alpine"}
          }
        }
      },
      "expect": {
        "status": 201,
        "kind": "Service",
        "requestIdInBody": false,
        "jsonPaths": {
          "name": "conformance-ws-{{run}}",
          "spec.mode": "replicated",
          "spec.task.image": "nginx:alpine"
        }
      }
    },
    {
      "name": "patch the service with the returned revision",
      "mutating": true,
      "request": {
        "method": "PATCH",
        "path": "/v1/services/conformance-ws-{{run}}",
        "role": "admin",
        "contentType": "application/merge-patch+json",
        "headers": {"If-Match": "$etag"},
        "body": {"labels": {"suite": "conformance", "patched": "true"}}
      },
      "expect": {
        "status": 200,
        "kind": "Service",
        "jsonPaths": {
          "name": "conformance-ws-{{run}}",
          "labels.patched": "true"
        }
      }
    },
    {
      "name": "delete the service",
      "mutating": true,
      "request": {
        "method": "DELETE",
        "path": "/v1/services/conformance-ws-{{run}}",
        "role": "admin",
        "headers": {"If-Match": "$etag"}
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "the write that just ran is in the audit log",
      "mockOnly": true,
      "request": {
        "method": "GET",
        "path": "/v1/audit",
        "query": {"limit": "1000"},
        "role": "admin"
      },
      "expect": {
        "status": 200,
        "kind": "AuditList",
        "requestIdInBody": false,
        "jsonPaths": {
          "items.*.action": "service.delete",
          "items.*.resource.name": "conformance-ws-{{run}}"
        },
        "absentKeysAnywhere": ["data"]
      }
    },
    {
      "name": "create a config",
      "mutating": true,
      "request": {
        "method": "POST",
        "path": "/v1/configs",
        "role": "admin",
        "body": {
          "name": "conformance-config-{{run}}",
          "labels": {"suite": "conformance"},
          "data": "listen 8080"
        }
      },
      "expect": {
        "status": 201,
        "kind": "Config",
        "jsonPaths": {
          "name": "conformance-config-{{run}}",
          "data": "listen 8080"
        }
      }
    },
    {
      "name": "delete the config",
      "mutating": true,
      "request": {
        "method": "DELETE",
        "path": "/v1/configs/conformance-config-{{run}}",
        "role": "admin",
        "headers": {"If-Match": "$etag"}
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "create a secret",
      "mutating": true,
      "request": {
        "method": "POST",
        "path": "/v1/secrets",
        "role": "admin",
        "body": {
          "name": "conformance-secret-{{run}}",
          "labels": {"suite": "conformance"},
          "data": "c2VjcmV0"
        }
      },
      "expect": {
        "status": 201,
        "kind": "Secret",
        "requestIdInBody": false,
        "jsonPaths": {"name": "conformance-secret-{{run}}"},
        "absentKeysAnywhere": ["data"]
      }
    },
    {
      "name": "delete the secret",
      "mutating": true,
      "request": {
        "method": "DELETE",
        "path": "/v1/secrets/conformance-secret-{{run}}",
        "role": "admin",
        "headers": {"If-Match": "$etag"}
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "a repeated create with an Idempotency-Key replays the first document",
      "mutating": true,
      "request": {
        "method": "POST",
        "path": "/v1/services",
        "role": "admin",
        "headers": {"Idempotency-Key": "conformance-idem-{{run}}"},
        "body": {
          "name": "conformance-idem-{{run}}",
          "labels": {"suite": "conformance"},
          "spec": {
            "mode": "replicated",
            "replicas": 1,
            "task": {"image": "nginx:alpine"}
          }
        }
      },
      "expect": {
        "status": 201,
        "kind": "Service",
        "requestIdInBody": false,
        "jsonPaths": {"name": "conformance-idem-{{run}}"},
        "absentKeysAnywhere": ["registryAuth"]
      },
      "repeat": {"times": 2, "sameBody": true}
    },
    {
      "name": "delete the replayed service",
      "mutating": true,
      "request": {
        "method": "DELETE",
        "path": "/v1/services/conformance-idem-{{run}}",
        "role": "admin",
        "headers": {"If-Match": "$etag"}
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "create a snapshot and expose its total size",
      "mutating": true,
      "requiresCapabilities": ["snapshots"],
      "request": {
        "method": "POST",
        "path": "/v1/tasks/$task/snapshots",
        "role": "admin"
      },
      "expect": {
        "status": 201,
        "kind": "Snapshot",
        "requestIdInBody": false,
        "presentKeys": ["id", "createdAt", "rootfsPath", "sizeBytes"],
        "minValues": {"sizeBytes": 1}
      },
      "capture": {"snapshot": "id"}
    },
    {
      "name": "a restore of a running task is refused",
      "mutating": true,
      "requiresCapabilities": ["snapshots"],
      "request": {
        "method": "POST",
        "path": "/v1/tasks/$task/snapshots/$snapshot/restore",
        "role": "admin"
      },
      "expect": {
        "status": 409,
        "errorCode": "conflict",
        "jsonPaths": {"error.details.reason": "restore_task_running"}
      }
    },
    {
      "name": "the flat restore alias refuses a running task too",
      "mutating": true,
      "requiresCapabilities": ["snapshots"],
      "request": {
        "method": "POST",
        "path": "/v1/snapshots/$snapshot/restore",
        "query": {"task": "$task"},
        "role": "admin"
      },
      "expect": {
        "status": 409,
        "errorCode": "conflict",
        "jsonPaths": {"error.details.reason": "restore_task_running"}
      }
    },
    {
      "name": "delete the snapshot it created",
      "mutating": true,
      "requiresCapabilities": ["snapshots"],
      "request": {
        "method": "DELETE",
        "path": "/v1/snapshots/$snapshot",
        "query": {"task": "$task"},
        "role": "admin"
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "upload a file as raw bytes",
      "mutating": true,
      "request": {
        "method": "PUT",
        "path": "/v1/tasks/$task/files",
        "query": {"path": "/tmp/conformance-file-{{run}}"},
        "role": "admin",
        "bodyBase64": "Y29uZm9ybWFuY2UgZmlsZQoAAf8="
      },
      "expect": {
        "status": 204
      }
    },
    {
      "name": "download the file byte for byte",
      "mutating": true,
      "request": {
        "method": "GET",
        "path": "/v1/tasks/$task/files",
        "query": {"path": "/tmp/conformance-file-{{run}}"},
        "role": "admin",
        "accept": "application/octet-stream"
      },
      "expect": {
        "status": 200,
        "headers": {"Content-Type": "application/octet-stream"},
        "bodyBase64": "Y29uZm9ybWFuY2UgZmlsZQoAAf8=",
        "bodyLength": 20
      }
    }
  ]
}

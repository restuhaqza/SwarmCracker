{
  "title": "SwarmCracker — VM Lifecycle",
  "uid": "swarmcracker-vm-lifecycle",
  "panels": [
    {
      "title": "VM Create Rate",
      "type": "graph",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "rate(swarmcracker_vm_creates_total[5m])", "legendFormat": "{{ instance }}"}]
    },
    {
      "title": "VM Stop Rate",
      "type": "graph",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "rate(swarmcracker_vm_stops_total[5m])", "legendFormat": "{{ instance }}"}]
    },
    {
      "title": "VM State Distribution",
      "type": "piechart",
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 6},
      "targets": [
        {"expr": "sum(swarmcracker_vms_running)", "legendFormat": "Running"},
        {"expr": "sum(swarmcracker_vms_total) - sum(swarmcracker_vms_running)", "legendFormat": "Stopped"}
      ]
    },
    {
      "title": "Boot Duration (p50/p95/p99)",
      "type": "graph",
      "gridPos": {"x": 8, "y": 8, "w": 16, "h": 6},
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(swarmcracker_vm_boot_duration_seconds_bucket[5m]))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, rate(swarmcracker_vm_boot_duration_seconds_bucket[5m]))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, rate(swarmcracker_vm_boot_duration_seconds_bucket[5m]))", "legendFormat": "p99"}
      ],
      "yaxis": {"format": "s", "label": "Seconds"}
    },
    {
      "title": "Boot Errors by Instance",
      "type": "graph",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 6},
      "targets": [{"expr": "rate(swarmcracker_vm_boot_errors_total[5m])", "legendFormat": "{{ instance }}"}]
    },
    {
      "title": "Snapshots Created",
      "type": "graph",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 6},
      "targets": [{"expr": "rate(swarmcracker_snapshots_created_total[5m])", "legendFormat": "{{ instance }}"}]
    }
  ],
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"}
}
